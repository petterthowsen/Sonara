[gd_scene format=3]

[ext_resource type="Script" path="res://devices/DevicePresetSaveDialog.gd" id="1_dlg"]

[node name="DevicePresetSaveDialog" type="Window"]
title = "Save Preset"
initial_position = 2
size = Vector2i(400, 240)
visible = false
exclusive = false
min_size = Vector2i(320, 220)
script = ExtResource("1_dlg")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Grid" type="GridContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 4
columns = 2

[node name="NameLabel" type="Label" parent="Margin/VBox/Grid"]
layout_mode = 2
text = "Name"

[node name="NameEdit" type="LineEdit" parent="Margin/VBox/Grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
size_flags_horizontal = 3

[node name="TagsLabel" type="Label" parent="Margin/VBox/Grid"]
layout_mode = 2
text = "Tags"

[node name="TagsEdit" type="LineEdit" parent="Margin/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "comma, separated"

[node name="AuthorLabel" type="Label" parent="Margin/VBox/Grid"]
layout_mode = 2
text = "Author"

[node name="AuthorEdit" type="LineEdit" parent="Margin/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="Status" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.6)
layout_mode = 2
autowrap_mode = 3

[node name="Spacer" type="Control" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="Buttons" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 4
alignment = 2

[node name="SaveButton" type="Button" parent="Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Save"

[node name="CancelButton" type="Button" parent="Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Cancel"

[node name="OverwriteConfirm" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
exclusive = false
transient = false

[node name="StateConfirm" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
exclusive = false
transient = false
dialog_text = "A plugin did not return its state in time. Save the preset with the plugin's last known state?"
ok_button_text = "Save anyway"
